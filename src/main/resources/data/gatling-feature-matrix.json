{
  "knownVersions": ["3.0", "3.1", "3.2", "3.3", "3.4", "3.5", "3.6", "3.7", "3.8", "3.9", "3.10", "3.11", "3.12", "3.13", "3.14", "3.15"],
  "supportedVersions": ["3.7", "3.8", "3.9", "3.10", "3.11", "3.12", "3.13", "3.14", "3.15"],
  "rules": [
    {"since": "3.0", "feature": "closed-workload-model", "message": "Gatling 3.0 introduced the closed workload model and related injection/profile changes."},
    {"since": "3.0", "feature": "http2", "message": "Gatling 3.0 introduced HTTP/2 support."},
    {"since": "3.1", "feature": "adaptive-csv-feeders", "message": "Gatling 3.1 changed CSV feeder loading behavior."},
    {"since": "3.2", "feature": "jmespath", "message": "Gatling 3.2 introduced JMESPath support."},
    {"since": "3.2", "feature": "bodyStream", "message": "Gatling 3.2 introduced bodyStream support."},
    {"since": "3.3", "feature": "chainable-composite-injection", "message": "Gatling 3.3 introduced chainable composite injection."},
    {"since": "3.4", "feature": "andThen", "message": "Gatling 3.4 introduced andThen injection composition."},
    {"since": "3.4", "feature": "exitHere", "message": "Gatling 3.4 introduced exitHere and exitHereIf."},
    {"since": "3.4", "feature": "jms-checks", "message": "Gatling 3.4 introduced JMS checks."},
    {"since": "3.5", "feature": "bodyLength", "message": "Gatling 3.5 introduced bodyLength checks."},
    {"since": "3.6", "feature": "brotli", "message": "Gatling 3.6 introduced Brotli support."},
    {"since": "3.6", "feature": "mqtt-per-user-key-managers", "message": "Gatling 3.6 introduced MQTT per-user key managers."},
    {"since": "3.7", "feature": "java-sdk", "languages": ["JAVA", "KOTLIN"], "confidence": "OFFICIAL_DOCS"},
    {"since": "3.7", "feature": "checkIf", "message": "Gatling 3.7 introduced checkIf support."},
    {"since": "3.7", "feature": "withDefault", "message": "Gatling 3.7 introduced withDefault support."},
    {"since": "3.8", "feature": "redesigned-andThen", "message": "Gatling 3.8 redesigned andThen."},
    {"since": "3.8", "feature": "websocket-close-status", "message": "Gatling 3.8 added WebSocket close status code support."},
    {"since": "3.9", "feature": "random-el-functions", "message": "Gatling 3.9 introduced random expression language functions."},
    {"since": "3.9", "feature": "recordsCount", "message": "Gatling 3.9 introduced recordsCount."},
    {"since": "3.10", "feature": "less-verbose-sequences", "message": "Gatling 3.10 introduced less verbose Java/Scala SDK sequence syntax."},
    {"since": "3.10", "feature": "oauth1-signature-modes", "message": "Gatling 3.10 introduced OAuth1 signature modes."},
    {"since": "3.11", "invalidPattern": "${", "replacement": "#{", "message": "Gatling 3.11+ uses #{...} expression language."},
    {"since": "3.11", "invalidPattern": "heavisideUsers", "replacement": "stressPeakUsers", "message": "Gatling 3.11 renamed heavisideUsers to stressPeakUsers."},
    {"since": "3.11", "invalidPattern": ".convert(", "replacement": ".transform(", "message": "Gatling 3.11 renamed feeder convert to transform."},
    {"since": "3.11", "invalidPattern": ".polling(", "replacement": ".poll(", "message": "Gatling 3.11 HTTP polling was renamed to poll."},
    {"since": "3.11", "invalidPattern": "wait(", "replacement": "await(", "message": "Gatling 3.11 MQTT wait was renamed to await."},
    {"since": "3.12", "invalidPattern": "stopInjector", "replacement": "stopLoadGenerator", "message": "Gatling 3.12 renamed injector terms to load generator terms."},
    {"since": "3.12", "invalidPattern": "Injector", "replacement": "LoadGenerator", "message": "Gatling 3.12 renamed Injector to LoadGenerator."},
    {"since": "3.13", "feature": "proxy-protocol-v1", "message": "Gatling 3.13 introduced PROXY protocol v1 support."},
    {"since": "3.13", "feature": "jms-property-checks", "message": "Gatling 3.13 introduced JMS property checks."},
    {"since": "3.13", "feature": "report-add-opens", "message": "Gatling 3.13 report generation can require --add-opens=java.base/java.lang=ALL-UNNAMED."},
    {"since": "3.14", "invalidPattern": "javax.jms", "replacement": "jakarta.jms", "message": "Gatling 3.14 JMS uses jakarta.jms."},
    {"since": "3.14", "feature": "dynamic-http-proxy-credentials", "message": "Gatling 3.14 introduced dynamic HTTP proxy credentials."},
    {"since": "3.15", "feature": "httpConcurrentRequests", "message": "Gatling 3.15 introduced direct httpConcurrentRequests."},
    {"since": "3.15", "feature": "logActualValueInError", "message": "Gatling 3.15 introduced logActualValueInError."},
    {"since": "3.15", "invalidPattern": "eager().queue()", "replacement": "default feeder loading behavior", "message": "Gatling 3.15 removed feeder loading mode control."}
  ],
  "protocols": [
    {"protocol": "HTTP", "generationMode": "deep"},
    {"protocol": "WEBSOCKET", "generationMode": "capability-only"},
    {"protocol": "SSE", "generationMode": "capability-only"},
    {"protocol": "JMS", "generationMode": "capability-only"},
    {"protocol": "MQTT", "generationMode": "capability-only"},
    {"protocol": "GRPC", "generationMode": "capability-only"}
  ]
}
